{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "AppRunnerRead", "Effect": "Allow", "Action": ["apprunner:List*", "apprunner:Describe*"], "Resource": "*" },
    { "Sid": "AppRunnerManage", "Effect": "Allow", "Action": "apprunner:*", "Resource": [
      "arn:aws:apprunner:*:ACCOUNT_ID:service/dandelist*",
      "arn:aws:apprunner:*:ACCOUNT_ID:service/dandelist*/*",
      "arn:aws:apprunner:*:ACCOUNT_ID:autoscalingconfiguration/dandelist*",
      "arn:aws:apprunner:*:ACCOUNT_ID:observabilityconfiguration/dandelist*",
      "arn:aws:apprunner:*:ACCOUNT_ID:connection/dandelist*"
    ] },
    { "Sid": "EcrAuth", "Effect": "Allow", "Action": ["ecr:GetAuthorizationToken", "ecr:CreateRepository", "ecr:DescribeRepositories"], "Resource": "*" },
    { "Sid": "EcrRepo", "Effect": "Allow", "Action": "ecr:*", "Resource": "arn:aws:ecr:*:ACCOUNT_ID:repository/dandelist*" },
    { "Sid": "Rds", "Effect": "Allow", "Action": "rds:*", "Resource": [
      "arn:aws:rds:*:ACCOUNT_ID:db:dandelist*",
      "arn:aws:rds:*:ACCOUNT_ID:subgrp:dandelist*",
      "arn:aws:rds:*:ACCOUNT_ID:snapshot:dandelist*",
      "arn:aws:rds:*:ACCOUNT_ID:pg:dandelist*"
    ] },
    { "Sid": "RdsShared", "Effect": "Allow", "Action": ["rds:Describe*", "rds:CreateDBSubnetGroup", "rds:AddTagsToResource", "rds:ListTagsForResource"], "Resource": "*" },
    { "Sid": "NetworkRead", "Effect": "Allow", "Action": "ec2:Describe*", "Resource": "*" },
    { "Sid": "NetworkCreateTagged", "Effect": "Allow", "Action": "ec2:CreateSecurityGroup", "Resource": "*", "Condition": { "StringEquals": { "aws:RequestTag/project": "dandelist" } } },
    { "Sid": "NetworkCreateIntoVpc", "Effect": "Allow", "Action": "ec2:CreateSecurityGroup", "Resource": "arn:aws:ec2:*:ACCOUNT_ID:vpc/*" },
    { "Sid": "NetworkTagOnCreate", "Effect": "Allow", "Action": "ec2:CreateTags", "Resource": "*", "Condition": { "StringEquals": { "ec2:CreateAction": "CreateSecurityGroup" } } },
    { "Sid": "NetworkIngressOwnGroups", "Effect": "Allow", "Action": ["ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress"], "Resource": "arn:aws:ec2:*:ACCOUNT_ID:security-group/*", "Condition": { "StringEquals": { "aws:ResourceTag/project": "dandelist" } } },
    { "Sid": "S3", "Effect": "Allow", "Action": "s3:*", "Resource": ["arn:aws:s3:::dandelist-*", "arn:aws:s3:::dandelist-*/*"] },
    { "Sid": "S3Account", "Effect": "Allow", "Action": ["s3:ListAllMyBuckets", "s3:CreateBucket"], "Resource": "*" },
    { "Sid": "Secrets", "Effect": "Allow", "Action": "secretsmanager:*", "Resource": "arn:aws:secretsmanager:*:ACCOUNT_ID:secret:dandelist*" },
    { "Sid": "SecretsAccount", "Effect": "Allow", "Action": ["secretsmanager:CreateSecret", "secretsmanager:ListSecrets", "secretsmanager:GetRandomPassword"], "Resource": "*" },
    { "Sid": "PassAppRunnerAccessRole", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::ACCOUNT_ID:role/dandelist-apprunner-ecr", "Condition": { "StringEquals": { "iam:PassedToService": ["apprunner.amazonaws.com", "build.apprunner.amazonaws.com"] } } },
    { "Sid": "PassAppRunnerInstanceRole", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::ACCOUNT_ID:role/dandelist-apprunner-instance" },
    { "Sid": "CodeBuild", "Effect": "Allow", "Action": ["codebuild:CreateProject", "codebuild:UpdateProject", "codebuild:StartBuild", "codebuild:BatchGetBuilds", "codebuild:BatchGetProjects"], "Resource": "arn:aws:codebuild:*:ACCOUNT_ID:project/dandelist*" },
    { "Sid": "PassCodeBuildRole", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::ACCOUNT_ID:role/dandelist-codebuild", "Condition": { "StringEquals": { "iam:PassedToService": "codebuild.amazonaws.com" } } },
    { "Sid": "ReadPrecreatedRoles", "Effect": "Allow", "Action": "iam:GetRole", "Resource": ["arn:aws:iam::ACCOUNT_ID:role/dandelist-apprunner-*", "arn:aws:iam::ACCOUNT_ID:role/dandelist-codebuild"] },
    { "Sid": "ServiceLinkedRoles", "Effect": "Allow", "Action": "iam:CreateServiceLinkedRole", "Resource": "*", "Condition": { "StringLike": { "iam:AWSServiceName": ["apprunner.amazonaws.com", "rds.amazonaws.com"] } } },
    { "Sid": "Logs", "Effect": "Allow", "Action": ["logs:DescribeLogGroups", "logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents"], "Resource": "*" },
    { "Sid": "CostRead", "Effect": "Allow", "Action": ["budgets:ViewBudget", "ce:GetCostAndUsage"], "Resource": "*" },
    { "Sid": "Whoami", "Effect": "Allow", "Action": "sts:GetCallerIdentity", "Resource": "*" }
  ]
}
