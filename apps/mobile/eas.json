{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "billing-internal": {
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dandelist.knightaiav.com",
        "EXPO_PUBLIC_BILLING_SANDBOX": "1"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "local",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dandelist.knightaiav.com"
      }
    },
    "apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dandelist.knightaiav.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6827360772",
        "appleTeamId": "9NB97BZDR3"
      }
    }
  }
}
