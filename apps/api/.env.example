# Copy to .env for local runs. Real values live in Railway variables and the vault, never in git.
DATABASE_URL=postgres://localhost:5432/dandelist
JWT_SECRET=
CODE_PEPPER=
RESEND_API_KEY=
MAIL_FROM=Dandelist <signin@knightaiav.com>
JUDGE_EMAIL=
JUDGE_CODE=
MODEL_API_KEY=
SPEND_DAILY_USD=10
SPEND_TOTAL_USD=120
# Claude under Meta: answers only calls Meta refuses once its spend is used up. Off while the key is empty.
ANTHROPIC_API_KEY=
CLAUDE_DAILY_USD=5
CLAUDE_SPEED=fast
# 1 also hands Claude the calls Meta's service fails (a 5xx after its retry)
CLAUDE_ON_META_ERRORS=
# Google Shopping via Apify (free plan only; the daily cap keeps cash spend at $0)
APIFY_TOKEN=
APIFY_DAILY_USD=0.15
# Agent-made pictures: the media bucket, and the API's public address that serves /media/<key>
MEDIA_BUCKET=
PUBLIC_API_URL=
AWS_REGION=us-east-1
# Meta image work, each off unless set to 1: SAM 3.1 cutouts, Muse Image fallback pictures and upscales
MEDIA_CUTOUTS=
MEDIA_GENERATE=
MEDIA_UPSCALE=
MEDIA_CUTOUTS_PER_DAY=100
MEDIA_IMAGES_PER_DAY=20
WEB_ORIGINS=https://dandelist.com,https://www.dandelist.com,http://localhost:8081
PORT=8080
